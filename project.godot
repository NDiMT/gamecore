; Godot 4 project configuration.
; Edited by hand here; the editor will regenerate UIDs/import data on first open.

config_version=5

[application]

config/name="GameCore — Co-op HeroQuest"
config/description="A co-operative HeroQuest-style dungeon crawl with a host-authoritative AI game master and ENet multiplayer. Mobile (touch) ready."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.043, 0.027, 0.051, 1)
boot_splash/image="res://icon.png"
boot_splash/fullsize=false

[autoload]

Data="*res://scripts/game/Data.gd"
Net="*res://scripts/net/Net.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=4
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
