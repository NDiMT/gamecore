{
  "name": "noclip-level0",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "NOCLIP — a Backrooms-style horror game (Electron + Three.js)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "electron:dev": "cross-env NOCLIP_DEV=1 electron electron/main.cjs",
    "electron:start": "npm run build && electron electron/main.cjs",
    "dist": "npm run build && electron-builder",
    "steam:win": "npm run build && electron-builder --win dir",
    "steam:linux": "npm run build && electron-builder --linux dir",
    "steam:mac": "npm run build && electron-builder --mac dir"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "peerjs": "^1.5.5",
    "three": "^0.169.0",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "com.noclip.level0",
    "productName": "NOCLIP",
    "copyright": "Copyright © 2026",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "steam_appid.txt",
        "to": "steam_appid.txt"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build-assets"
    },
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "artifactName": "NOCLIP-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.games"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game"
    }
  }
}
